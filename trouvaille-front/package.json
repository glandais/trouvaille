{
  "name": "trouvaille-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/ public/ *.json *.md",
    "format:check": "prettier --check src/ public/ *.json *.md",
    "generate:api": "npm run generate:api:clean && npm run generate:api:generate",
    "generate:api:clean": "rm -rf src/api",
    "generate:api:generate": "openapi-generator-cli generate -i ../contract.yaml -g typescript-axios -o src/api --additional-properties=supportsES6=true,npmName=@trouvaille/api,modelPropertyNaming=snake_case,stringEnums=true"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@toast-ui/editor": "^3.2.2",
    "@vueuse/core": "^14.2.0",
    "axios": "^1.13.4",
    "dompurify": "^3.2.6",
    "localstorage-slim": "^2.7.1",
    "lodash-es": "^4.17.23",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-preview-imgs": "^2.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tsconfig/node22": "^22.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.7.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "dompurify": "^3.2.6"
  }
}
